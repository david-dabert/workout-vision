public/mediapipe/
public/ffmpeg/

# Staging videos and temp files
benchmark/staging/*.mp4

# David's real-phone clips and unverified benchmark videos
test/real-phone/clips/
benchmark/unverified/

# All video files anywhere (any case)
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM]4[vV]
*.[wW][eE][bB][mM]

# Frame PNGs from test extraction (stay on Mac only)
test/real-phone/frames/
test/real-phone/round7/frames/

# Uncompressed landmark JSON (commit only .gz and manifest.json)
test/real-phone/landmarks/*.json
!test/real-phone/landmarks/manifest.json

# App-served guide artwork generated from the pinned package
public/guide/

# Exam sets: opened by the exam script only (PLAN.md). The script and its protocol are tracked.
test/real-phone/exam/*/
test/real-phone/exam/**/*.json.gz

# Shots and results.json written by a local run of the tour in CI (test/real-phone/tour-ci/tour.mjs).
test/real-phone/tour-ci/*/

# Public held-out half: read only by its own run (test/real-phone/accuracy/public-holdout.test.ts), never committed.
test/real-phone/public/*/holdout/

# Python bytecode
__pycache__/

# The Journey job (ci.yml): rendered synthetic sets and their shots, never committed
.journey-sets/
journey/
smoke-shots/
