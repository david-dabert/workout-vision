{
  "name": "workout-vision",
  "private": true,
  "version": "1.4.0",
  "description": "On-device AI workout analysis — rep counting, form scoring, and biomechanical feedback from video. Runs entirely in-browser with MediaPipe.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-models.js",
    "build": "vite build && node scripts/inject-sw-precache.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "vite build && npx gh-pages -d dist",
    "test": "vitest run",
    "test:benchmark": "node benchmark/replay-benchmark.mjs --ci",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.8",
    "jspdf": "^4.2.1",
    "localforage": "^1.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-demuxer": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
