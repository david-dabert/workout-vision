{
  "name": "workout-vision",
  "private": true,
  "version": "1.4.0",
  "description": "On-device AI workout analysis — rep counting, form scoring, and biomechanical feedback from video. Runs entirely in-browser with MediaPipe.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-models.js",
    "build": "vite build && node scripts/inject-sw-precache.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "vite build && npx gh-pages -d dist",
    "test": "vitest run",
    "test:benchmark": "node benchmark/replay-benchmark.mjs --ci",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.8",
    "localforage": "^1.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "vite": "^5.4.21",
    "vitest": "^4.1.11"
  }
}
