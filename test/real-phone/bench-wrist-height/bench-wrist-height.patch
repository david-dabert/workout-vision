@@ -0,0 +1,72 @@
+/**
+ * The bench press is found on the wrist's height above the shoulder (core.ts, countOn, WRIST_HEIGHT_UNITS_PER_M),
+ * workflow experiment of 3 October 2026 on the public build half A. What it answers: at the bottom of a bench rep
+ * the elbow sinks behind the torso and the bench, and the pose model places it worst there, while it still places
+ * the shoulder and the wrist. On a public set of eleven quick reps (Countix E9KZOVuBRfA, about 0.9 s each) the elbow
+ * angle read 128 to 131 degrees with the wrist at the chest, the pose was lost for a sample or two at most bottoms,
+ * the true bottoms (70 to 90 degrees) were erased as outliers, and the core counted 5.
+ * Here the body presses as a bench press is done (pressFrame: the forearm upright), quick reps of about 1 s; at each
+ * bottom, while the elbow is under 100 degrees, its landmark is put where it reads 131 degrees, and the pose is lost
+ * for two samples; every frame's elbow jitters by up to 6 cm and its shoulder and wrist by up to 2 cm (the elbow is
+ * the landmark placed worst; the sizes are a modelling choice, not a measurement). On the elbow angle such sets
+ * counted 10 in 3 of 40 seeds (mean 8.1); on the wrist's height, 40 of 40. Status: experimental.
+ */
+import { describe, it, expect } from 'vitest';
+import { countReps, type WorldLandmarkFrame } from '../core';
+import { pressFrame, sample, seeded, timestamps, type Segment } from './synthetic';
+
+/** pressFrame, with the elbow moved off the shoulder–wrist line (in depth) so that it reads `reads` degrees. */
+function misplacedElbow(angle: number, reads: number): WorldLandmarkFrame {
+  const f = pressFrame(angle)!;
+  const s = f[11], w = f[15];
+  const half = Math.hypot(w.x - s.x, w.y - s.y, w.z - s.z) / 2;
+  const depth = half / Math.tan(((reads / 2) * Math.PI) / 180);
+  f[13] = { x: (s.x + w.x) / 2, y: (s.y + w.y) / 2, z: depth, visibility: 0.99 };
+  return f;
+}
+
+/** Each of the arm's landmarks moved by up to `elbow` (the elbow) or `ends` (shoulder, wrist) metres on each axis. */
+function jitter(f: WorldLandmarkFrame, rng: () => number, elbow: number, ends: number): WorldLandmarkFrame {
+  if (!f) return f;
+  const g = f.map(p => ({ ...p }));
+  for (const [k, a] of [[11, ends], [13, elbow], [15, ends]] as const) {
+    g[k] = { ...g[k], x: g[k].x + (rng() - 0.5) * 2 * a, y: g[k].y + (rng() - 0.5) * 2 * a, z: g[k].z + (rng() - 0.5) * 2 * a };
+  }
+  return g;
+}
+
+const presses = (n: number, down: number, bottom: number, up: number, top: number, rest = 160, work = 75): Segment[] => {
+  const p: Segment[] = [{ hold: rest, sec: 1 }];
+  for (let r = 0; r < n; r++) p.push({ to: work, sec: down }, { hold: work, sec: bottom }, { to: rest, sec: up }, { hold: rest, sec: top });
+  p.push({ hold: rest, sec: 1 });
+  return p;
+};
+
+describe('bench press: reps found on the wrist height', () => {
+  it('ten quick reps whose elbow is misplaced at the bottom, with the pose lost there, count 10, over 40 seeds', () => {
+    const sps = 15, counts: number[] = [];
+    for (let seed = 1; seed <= 40; seed++) {
+      const rng = seeded(seed * 7919 + sps);
+      const angles = sample(presses(10, 0.4, 0.1, 0.4, 0.1), 160, sps);
+      let atBottom = 0;
+      const frames = angles.map(a => {
+        if (a >= 100) { atBottom = 0; return jitter(pressFrame(a), rng, 0.06, 0.02); }
+        atBottom++;
+        if (a === 75 && atBottom > 1 && atBottom <= 3) return null; // the pose lost for two samples at the bottom
+        return jitter(misplacedElbow(a, 131), rng, 0.06, 0.02);
+      });
+      counts.push(countReps(frames, timestamps(angles.length, sps), 'bench_press').count);
+    }
+    expect(counts.filter(c => c !== 10)).toEqual([]);
+  });
+
+  it('the reps keep the elbow range in degrees, not the height', () => {
+    // Slow, clean reps, 170 to 80 degrees: each rep's range is the elbow's, about 90 degrees.
+    const sps = 15, angles = sample(presses(5, 1, 0, 1, 0.8, 170, 80), 170, sps);
+    const r = countReps(angles.map(a => pressFrame(a)), timestamps(angles.length, sps), 'bench_press');
+    expect(r.count).toBe(5);
+    for (const rep of r.reps) expect(rep.romDegrees).toBeGreaterThan(80);
+    for (const rep of r.reps) expect(rep.romDegrees).toBeLessThan(95);
+    expect(r.smoothedAngles.filter(a => a !== null).every(a => a! >= 75 && a! <= 175)).toBe(true);
+  });
+});
