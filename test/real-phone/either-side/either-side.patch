diff --git a/src/lib/counting/__tests__/lunge.test.ts b/src/lib/counting/__tests__/lunge.test.ts
new file mode 100644
index 0000000..db18047
--- /dev/null
+++ b/src/lib/counting/__tests__/lunge.test.ts
@@ -0,0 +1,54 @@
+/**
+ * Alternating lunges (public benchmark, 30 September 2026). A lunge steps forward on one leg, then on the
+ * other: the front knee bends deep and the back knee less. Read on one knee, every other lunge is a
+ * shallow bend that the thresholds, set by the deep ones, do not count, and the set reads half. Each knee
+ * is counted on its own and the two are joined, as for the alternating curl: bends of both knees that
+ * overlap are one lunge. Status: measured on the Countix build half (test/real-phone/accuracy/).
+ */
+import { describe, it, expect } from 'vitest';
+import { countReps } from '../core';
+import { jointFrame, timestamps } from './synthetic';
+
+const SPS = 30;
+// n lunges of `sec` each, alternating legs: the front knee goes to 90°, the back knee to 130°, from 175°.
+function lunges(n: number, sec: number) {
+  const frames = [], per = Math.round(sec * SPS), pause = Math.round(0.6 * SPS);
+  for (let i = 0; i < pause; i++) frames.push(jointFrame('knee', { left: 175, right: 175 }));
+  for (let r = 0; r < n; r++) {
+    const front = r % 2 === 0 ? 'left' : 'right', back = front === 'left' ? 'right' : 'left';
+    for (let i = 0; i < per; i++) {
+      const k = Math.sin((Math.PI * i) / per);
+      frames.push(jointFrame('knee', { [front]: 175 - 85 * k, [back]: 175 - 45 * k }));
+    }
+    for (let i = 0; i < pause; i++) frames.push(jointFrame('knee', { left: 175, right: 175 }));
+  }
+  return frames;
+}
+
+describe('alternating lunges', () => {
+  for (const n of [6, 10]) {
+    it(`${n} lunges, legs alternating, count ${n}`, () => {
+      const f = lunges(n, 1.6);
+      expect(countReps(f, timestamps(f.length, SPS), 'lunge').count).toBe(n);
+    });
+  }
+});
+
+describe('either side does the rep', () => {
+  it('lunges whose two legs the pose model swaps every few lunges still count once each', () => {
+    // Hips, knees and ankles (23 to 28) swap left for right every 70 samples, as a side-on video can.
+    const pair = (j: number) => (j >= 23 && j <= 28 ? (j % 2 ? j + 1 : j - 1) : j);
+    const f = lunges(8, 1.6).map((frame, i) => (frame && Math.floor(i / 70) % 2 ? frame.map((_, j) => frame[pair(j)]) : frame));
+    expect(countReps(f, timestamps(f.length, SPS), 'lunge').count).toBe(8);
+  });
+  it('front raises done arm by arm count one per raise', () => {
+    const frames = [], per = Math.round(1.6 * SPS), pause = Math.round(0.6 * SPS);
+    for (let i = 0; i < pause; i++) frames.push(jointFrame('shoulder', { left: 15, right: 15 }));
+    for (let r = 0; r < 8; r++) {
+      const side = r % 2 === 0 ? 'left' : 'right', other = side === 'left' ? 'right' : 'left';
+      for (let i = 0; i < per; i++) frames.push(jointFrame('shoulder', { [side]: 15 + 80 * Math.sin((Math.PI * i) / per), [other]: 15 }));
+      for (let i = 0; i < pause; i++) frames.push(jointFrame('shoulder', { left: 15, right: 15 }));
+    }
+    expect(countReps(frames, timestamps(frames.length, SPS), 'front_raise').count).toBe(8);
+  });
+});
